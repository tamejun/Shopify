# Shopify 설정
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# NinjaVan 설정
NINJAVAN_CLIENT_ID=your_client_id
NINJAVAN_CLIENT_SECRET=your_client_secret
NINJAVAN_COUNTRY=SG

# NinjaVan 발송인 정보 (Sender)
SENDER_NAME=Your Store Name
SENDER_PHONE=+65xxxxxxxx
SENDER_EMAIL=store@example.com
SENDER_ADDRESS1=123 Example Street
SENDER_ADDRESS2=
SENDER_CITY=Singapore
SENDER_STATE=Singapore
SENDER_POSTCODE=000000

# ── TikTok 연동 (선택사항) ────────────────────────────────────────────────────
# TikTok Events API (픽셀 - 구매 이벤트 서버 전송)
# TikTok Business Manager → Events → Manage → Web Events API 에서 발급
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=

# TikTok Shop API (상품/주문 연동 - TikTok Partner 계정 필요)
# https://partner.tiktokshop.com 에서 앱 등록 후 발급
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_CIPHER=  # OAuth 완료 후 응답에서 받는 shop_cipher 값

# ── Google 연동 (선택사항) ────────────────────────────────────────────────────
# Google Analytics 4 Measurement Protocol (구매 이벤트 서버 전송)
# GA4 → 관리 → 데이터 스트림 → Measurement Protocol API 비밀에서 발급
GOOGLE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_GA4_API_SECRET=

# Google Merchant Center (상품 피드 동기화 - 서비스 계정 JSON 필요)
# Google Cloud Console → 서비스 계정 생성 → JSON 키 발급 후 한 줄로 입력
GOOGLE_MERCHANT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
